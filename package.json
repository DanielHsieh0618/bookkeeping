{
  "name": "bookkeeping",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:frontend": "pnpm --dir apps/frontend run dev",
    "dev:backend": "uv run --directory apps/backend uvicorn app.main:app --host 0.0.0.0 --port 4000 --reload --ssl-certfile=certificates/localhost.pem --ssl-keyfile=certificates/localhost-key.pem",
    "build": "pnpm --dir apps/frontend run build",
    "lint": "pnpm --dir apps/frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
